# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local environment
.env*

# Claude Code
.context/
.claude/settings.local.json

# Python bytecode (guard hooks are Python even in non-Python repos)
__pycache__/
*.py[cod]

# Go
/cc-runtime
*.test
*.out

# Plugin binary (built locally or installed at runtime, never committed)
/plugin/bin/*
!/plugin/bin/.gitkeep

# Embedded SPA build output — rebuilt by the web build; keep only the committed
# placeholder so a clean tree compiles with no web toolchain.
/internal/web/dist/*
!/internal/web/dist/index.html
